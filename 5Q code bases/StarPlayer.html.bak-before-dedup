        { name: "ArcadeKing", emoji: "👑" },
        { name: "MelodyMaker", emoji: "🎵" }
      ];

      // Shuffle and pick 3 random friends
      const shuffled = mockFriends.sort(() => 0.5 - Math.random()).slice(0, 3);
      
      shuffled.forEach(f => {
        resultsDiv.innerHTML += `
          <div class="friend-card">
            <div class="friend-avatar">${f.emoji}</div>
            <div>
              <div style="font-weight: 700; color: #f8fafc;">${f.name}</div>
