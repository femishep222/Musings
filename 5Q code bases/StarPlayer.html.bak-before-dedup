      drawChibi(canvas.width - 150, canvas.height - 80, 1.1, -1);
    }

    canvas.addEventListener("mousedown", (e) => {
      if (mode !== "simon" || simonState !== "waiting") return;
      const rect = canvas.getBoundingClientRect(), scaleX = canvas.width / rect.width, scaleY = canvas.height / rect.height;
      const x = (e.clientX - rect.left) * scaleX, y = (e.clientY - rect.top) * scaleY;
      const size = 130, spacing = 10, startX = (canvas.width / 2) - size - (spacing / 2) - 80, startY = (canvas.height / 2) - size - (spacing / 2);
      const positions = [{ x: startX, y: startY }, { x: startX + size + spacing, y: startY }, { x: startX, y: startY + size + spacing }, { x: startX + size + spacing, y: startY + size + spacing }];
      
      for (let i = 0; i < 4; i++) {
        if (x >= positions[i].x && x <= positions[i].x + size && y >= positions[i].y && y <= positions[i].y + size) {
          playerSeq.push(i); drawSimon(i); playSynthSound(simonFreqs[i], 0.2); setTimeout(() => drawSimon(-1), 200);
          
          if (playerSeq[playerSeq.length - 1] !== simonSeq[playerSeq.length - 1]) {
            if (loseLife()) { 
              gameStatus.textContent = "💀 GAME OVER 💀"; 
              playSynthSound(100, 0.5, "sawtooth"); 
              setTimeout(stopGame, 2000); 
            } else { 
              simonState = "idle"; 
              gameStatus.textContent = "Wrong! Watch again..."; 
              setTimeout(() => { simonSeq.pop(); initSimonLevel(); }, 1000); 
            }
          } else if (playerSeq.length === simonSeq.length) {
            simonState = "idle";
            if (currentLevel < maxLevels) { 
              currentLevel++; 
              gameStatus.textContent = "Correct! Next round..."; 
              setTimeout(initSimonLevel, 1200); 
            } else { 
              gameStatus.textContent = "🧠 MEMORY MASTER! 🧠"; 
              playSynthSound(800, 0.6); 
              setTimeout(stopGame, 3000); 
            }
          }
          break;
        }
      }
    });

    window.onload = () => { showPage('home'); updateChibiPreview(); };
  </script>
