              <button style="margin-top: 8px; padding: 4px 10px; border:none; background: var(--primary); color:white; border-radius: 6px; cursor:pointer; font-size:12px;">Add Friend</button>
            </div>
          </div>
        `;
      });
    }

    // ===== AUDIO SYSTEM =====
    let soundEnabled = true;
    let audioCtx = null;
    function toggleSound() {
      soundEnabled = !soundEnabled;
      document.getElementById("soundText").textContent = soundEnabled ? "ON" : "OFF";
      document.getElementById("soundIcon").textContent = soundEnabled ? "🔊" : "🔇";
    }
    function playSynthSound(freq, duration, type="sine") {
      if (!soundEnabled) return;
      try {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        if (!audioCtx && AudioCtx) audioCtx = new AudioCtx();
        if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
        if (!audioCtx) return;
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = type; osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.12, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + duration);
        osc.connect(gain); gain.connect(audioCtx.destination);
        osc.start(); osc.stop(audioCtx.currentTime + duration);
      } catch(e) {}
    }

    // ===== LEVEL & LIVES SYSTEM =====
    let playerLives = 3;
    let currentLevel = 1;
    const maxLevels = 10;

    function teleport() {
      const selected = parseInt(document.getElementById("levelSelectDrop").value);
      currentLevel = selected;
      if (mode === "obby") {
        initObbyLevel();
      } else {
        startObbyGame(); 
      }
    }

    function updateLivesHUD() {
      const hud = document.getElementById("livesDisplay");
      if (playerLives <= 0) hud.textContent = "💀 GAME OVER";
      else hud.textContent = "❤️".repeat(playerLives);
    }
    function resetGameStats() {
      playerLives = 3;
      updateLivesHUD();
      updateLevelHUD();
    }
    function updateLevelHUD() {
      const lvlDisp = document.getElementById("levelDisplay");
      if (mode) {
        lvlDisp.style.display = "block";
        lvlDisp.textContent = `Level: ${currentLevel}/${maxLevels}`;
      } else {
        lvlDisp.style.display = "none";
      }
    }
    function loseLife() {
      playerLives--;
      updateLivesHUD();
      playSynthSound(150, 0.4, "sawtooth");
      return playerLives <= 0;
    }

    // ===== NAVIGATION & ENGINE =====
    function showPage(page) {
      stopGame();
      document.querySelectorAll(".page").forEach(p => p.classList.remove("active"));
      document.getElementById(page).classList.add("active");
      document.querySelectorAll("nav button").forEach(btn => btn.classList.remove("active-btn"));
      const activeNav = document.getElementById("btn-" + page);
      if (activeNav) activeNav.classList.add("active-btn");
      playSynthSound(440, 0.08);
      if (page === 'games') setTimeout(updateChibiPreview, 50);
    }

    const canvas = document.getElementById("gameCanvas");
    const ctx = canvas.getContext("2d");
    const gameStatus = document.getElementById("gameStatus");
    const gameHint = document.getElementById("gameHint");

    const colorPick = {
      skin: () => document.getElementById("skinColor").value,
      hairStyle: () => document.getElementById("hairStyle").value,
      hair: () => document.getElementById("hairColor").value,
      expression: () => document.getElementById("expression").value,
      accessory: () => document.getElementById("accessory").value,
      outfitStyle: () => document.getElementById("outfitStyle").value,
      shirt: () => document.getElementById("shirtColor").value,
      pants: () => document.getElementById("pantsColor").value
    };

    function clearCanvas() { ctx.clearRect(0, 0, canvas.width, canvas.height); }

    function drawChibi(x, y, scale = 1, dir = 1) {
      const skin = colorPick.skin(), hairStyle = colorPick.hairStyle(), hair = colorPick.hair();
      const expr = colorPick.expression(), acc = colorPick.accessory();
      const outfit = colorPick.outfitStyle(), shirt = colorPick.shirt(), pants = colorPick.pants();
      const s = 0.95 * scale, headR = 18 * s, headX = x, headY = y - 56 * s;

      // Back Hair
      ctx.fillStyle = hair;
      if (hairStyle === 'wavy') {
