      const hud = document.getElementById("livesDisplay");
      if (playerLives <= 0) hud.textContent = "💀 GAME OVER";
      else hud.textContent = "❤️".repeat(playerLives);
    }
    function resetGameStats() {
      playerLives = 3;
      updateLivesHUD();
      updateLevelHUD();
    }
    function updateLevelHUD() {
      const lvlDisp = document.getElementById("levelDisplay");
      if (mode) {
        lvlDisp.style.display = "block";
        lvlDisp.textContent = `Level: ${currentLevel}/${maxLevels}`;
      } else {
        lvlDisp.style.display = "none";
      }
    }
    function loseLife() {
      playerLives--;
      updateLivesHUD();
      playSynthSound(150, 0.4, "sawtooth");
      return playerLives <= 0;
    }

    // ===== NAVIGATION & ENGINE =====
