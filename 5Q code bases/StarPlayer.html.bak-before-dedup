        lvlDisp.style.display = "block";
        lvlDisp.textContent = `Level: ${currentLevel}/${maxLevels}`;
      } else {
        lvlDisp.style.display = "none";
      }
    }
    function loseLife() {
      playerLives--;
      updateLivesHUD();
      playSynthSound(150, 0.4, "sawtooth");
      return playerLives <= 0;
    }

    // ===== NAVIGATION & ENGINE =====
    function showPage(page) {
      stopGame();
      document.querySelectorAll(".page").forEach(p => p.classList.remove("active"));
      document.getElementById(page).classList.add("active");
      document.querySelectorAll("nav button").forEach(btn => btn.classList.remove("active-btn"));
      const activeNav = document.getElementById("btn-" + page);
      if (activeNav) activeNav.classList.add("active-btn");
      playSynthSound(440, 0.08);
      if (page === 'games') setTimeout(updateChibiPreview, 50);
    }

    const canvas = document.getElementById("gameCanvas");
    const ctx = canvas.getContext("2d");
    const gameStatus = document.getElementById("gameStatus");
    const gameHint = document.getElementById("gameHint");

