  <script>
    if (!CanvasRenderingContext2D.prototype.roundRect) {
      CanvasRenderingContext2D.prototype.roundRect = function (x, y, w, h, r = 0) {
        if (typeof r === 'number') r = [r, r, r, r];
        this.beginPath(); this.moveTo(x + r[0], y); this.lineTo(x + w - r[1], y);
        this.quadraticCurveTo(x + w, y, x + w, y + r[1]); this.lineTo(x + w, y + h - r[2]);
        this.quadraticCurveTo(x + w, y + h, x + w - r[2], y + h); this.lineTo(x + r[3], y + h);
        this.quadraticCurveTo(x, y + h, x, y + h - r[3]); this.lineTo(x, y + r[0]);
        this.quadraticCurveTo(x, y, x + r[0], y); this.closePath();
        return this;
      };
    }

    // ===== FIND FRIENDS SYSTEM =====
    function findCommunity() {
      const query = document.getElementById("interest").value.trim().toLowerCase();
      const resultsDiv = document.getElementById("results");
      resultsDiv.innerHTML = ""; // clear previous

      if (!query) {
        resultsDiv.innerHTML = "<p style='color:#ef4444; width:100%;'>Please enter an interest!</p>";
        return;
      }

      // Mock database of random friends
      const mockFriends = [
        { name: "PixelNinja", emoji: "🥷" },
        { name: "StarGazer99", emoji: "🌟" },
        { name: "ChibiMaster", emoji: "😸" },
        { name: "CodeWizard", emoji: "🧙‍♂️" },
        { name: "ArcadeKing", emoji: "👑" },
        { name: "MelodyMaker", emoji: "🎵" }
      ];

      // Shuffle and pick 3 random friends
      const shuffled = mockFriends.sort(() => 0.5 - Math.random()).slice(0, 3);
      
      shuffled.forEach(f => {
        resultsDiv.innerHTML += `
          <div class="friend-card">
            <div class="friend-avatar">${f.emoji}</div>
            <div>
              <div style="font-weight: 700; color: #f8fafc;">${f.name}</div>
